{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "BOT2.PY",
        "telegram bot ece/data/**"
      ]
    }
  },
  "routes": [
    {
      "src": "/webhook",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "buildCommand": "pip install -r requirements.txt",
  "devCommand": "python api/index.py",
  "installCommand": "pip install -r requirements.txt"
}

{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "**"
    }
  },
  "routes": [
    {
      "src": "/webhook",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "buildCommand": "pip install -r requirements.txt",
  "devCommand": "python api/index.py",
  "installCommand": "pip install -r requirements.txt"
}